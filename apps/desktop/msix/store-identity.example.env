# Copy to store-identity.env and fill with values from Microsoft Partner Center.
# Path: apps/desktop/msix/store-identity.env  (gitignored — never commit secrets)
#
# Where to find these in Partner Center:
#   1. Open https://partner.microsoft.com/dashboard
#   2. Apps and games → your ServerUI product (or create an MSIX app)
#   3. Product management → App identity
#
# From that page, copy:
#   Package/Identity/Name          → STORE_PACKAGE_IDENTITY_NAME
#   Package/Identity/Publisher     → STORE_PUBLISHER  (full DN, usually CN={GUID})
#   Package/Properties/PublisherDisplayName → STORE_PUBLISHER_DISPLAY_NAME
#
# Do NOT invent the Publisher CN / GUID. Store submission fails if these mismatch.

STORE_PACKAGE_IDENTITY_NAME=REPLACE_WITH_PARTNER_CENTER_PACKAGE_IDENTITY_NAME
STORE_PUBLISHER=CN=REPLACE_WITH_PARTNER_CENTER_PUBLISHER_ID
STORE_PUBLISHER_DISPLAY_NAME=Skyrekon Private Limited

# Pack mode:
#   store  — unsigned .msix for Partner Center upload (default when identity file is used)
#   local  — self-signed package for sideload testing on this machine
# STORE_PACK_MODE=store
